extends layout

block content
  article.post
    header.post-header
      h1= post.title
      p.meta
        time(datetime=post.date)= new Date(post.date).toLocaleDateString()
        span.reading-time= post.readingTime
      if post.tags && post.tags.length > 0
        .tags
          each tag in post.tags
            span.tag ##{tag}
    
    div.post-content!= post.content
    
    nav.post-nav
      a(href="/") ← Back to posts